{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q20396.example/sandbox/external-capability-source-effect-assessment.schema.json",
  "title": "External Capability Source and Effect Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_reference", "source_class", "declared_effects",
    "observed_static_indicators", "task_requested_effects",
    "task_authorized_effects", "operation_binding", "evidence_minimum",
    "host_enforcement_required", "host_enforcement_claim",
    "planned_outcome", "reason_category"
  ],
  "properties": {
    "source_reference": {"type": "string", "pattern": "^SOURCE-SYNTHETIC-[0-9]{3}$"},
    "source_class": {"enum": ["EXTERNAL_PROVIDER", "HOST_CAPABILITY", "DECLARED_STATIC_ARTIFACT"]},
    "declared_effects": {"$ref": "#/$defs/effectArray"},
    "observed_static_indicators": {"$ref": "#/$defs/indicatorArray"},
    "task_requested_effects": {"$ref": "#/$defs/effectArray"},
    "task_authorized_effects": {"$ref": "#/$defs/effectArray"},
    "operation_binding": {"$ref": "#/$defs/operationBinding"},
    "evidence_minimum": {"$ref": "#/$defs/evidenceMinimum"},
    "host_enforcement_required": {"type": "boolean"},
    "host_enforcement_claim": {"enum": ["NOT_APPLICABLE", "FUTURE_VERIFIABLE", "NOT_AVAILABLE", "NOT_PROVEN", "CONFLICTING"]},
    "planned_outcome": {"enum": ["BLOCKED", "OUT_OF_SCOPE", "EXTERNAL_CAPABILITY_ASSESSMENT_DESIGNED_ONLY"]},
    "reason_category": {"enum": ["STRUCTURE_OR_REFERENCE_INVALID", "SOURCE_OR_SENSITIVITY_UNKNOWN", "BINDING_OR_DECISION_INVALID", "EFFECT_EXPANSION_BLOCKED", "ACTUAL_CAPABILITY_NOT_AUTHORIZED", "HOST_ENFORCEMENT_NOT_PROVEN", "STATIC_DESIGN_ONLY"]}
  },
  "$defs": {
    "effect": {"enum": ["NO_EXTERNAL_EFFECT", "STATIC_CONTRACT_ANALYSIS", "TARGET_CONTENT_READ", "TARGET_CONTENT_WRITE", "PATH_RESOLUTION_OR_SYMLINK_INSPECTION", "AUTHORIZATION_LOOKUP", "RENDER_OR_RETENTION_PROCESSING", "NETWORK_OR_PROVIDER_REQUEST", "HOST_CONTROL_OR_SCHEDULING", "subprocess_execution", "package_installation", "dynamic_import", "model_context_disclosure", "background_upload", "process_spawn"]},
    "effectArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/effect"}},
    "indicatorArray": {"type": "array", "uniqueItems": true, "items": {"enum": ["SOURCE_REFERENCE_DECLARED", "SOURCE_CLASS_DECLARED", "PROVENANCE_CLASSIFIED", "SENSITIVITY_CLASSIFIED", "REDACTION_CLASSIFIED", "DECLARED_EFFECTS_CLASSIFIED", "TASK_REQUESTED_EFFECTS_CLASSIFIED", "TASK_AUTHORIZED_EFFECTS_CLASSIFIED", "OPERATION_BINDING_DECLARED", "HOST_ENFORCEMENT_UNAVAILABLE", "HOST_ENFORCEMENT_UNPROVEN", "HOST_ENFORCEMENT_CONFLICTING"]}},
    "operationBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["task_reference", "operation_intent", "evaluation_at", "task_requested_effects", "task_authorized_effects", "target", "range", "proposal_or_disposition_reference", "prior_effect_scope", "expires_at", "revocation_state"],
      "properties": {
        "task_reference": {"type": "string", "pattern": "^TASK-SYNTHETIC-[0-9]{3}$"},
        "operation_intent": {"const": "STATIC_ASSESSMENT"},
        "evaluation_at": {"type": "string", "format": "date-time"},
        "task_requested_effects": {"$ref": "#/$defs/effectArray"},
        "task_authorized_effects": {"$ref": "#/$defs/effectArray"},
        "target": {"const": "SYNTHETIC_EXTERNAL_CAPABILITY"},
        "range": {"const": "DECLARATION_ONLY"},
        "proposal_or_disposition_reference": {"type": "string", "pattern": "^DISPOSITION-SYNTHETIC-[0-9]{3}$"},
        "prior_effect_scope": {"$ref": "#/$defs/effectArray"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revocation_state": {"enum": ["NOT_REVOKED", "REVOKED"]}
      }
    },
    "evidenceMinimum": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_classification", "sensitivity_classification", "redaction_classification", "retention_classification", "bounded_reference_claim"],
      "properties": {
        "provenance_classification": {"enum": ["DECLARED", "UNKNOWN", "CONTRADICTORY"]},
        "sensitivity_classification": {"enum": ["DECLARED_NON_SENSITIVE", "UNKNOWN", "CONTRADICTORY"]},
        "redaction_classification": {"enum": ["DECLARED_COMPLETE", "INCOMPLETE", "UNKNOWN", "CONTRADICTORY"]},
        "retention_classification": {"enum": ["DECLARED_NON_RETAINING", "UNKNOWN", "PROTECTED_CONTENT", "CONTRADICTORY"]},
        "bounded_reference_claim": {"type": "string", "pattern": "^DISPOSITION-SYNTHETIC-[0-9]{3}$"}
      }
    }
  }
}
