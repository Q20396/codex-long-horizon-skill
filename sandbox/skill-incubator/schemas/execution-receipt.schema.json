{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lhe:execution-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "record_id", "request_id", "synthetic", "fixture_only", "execution_status", "tool_invocation", "external_effects_observed", "output_material", "runtime_execution", "subject_identity_digest", "requested_effects_digest", "source_scope_digest", "input_contract_digest", "persistence"],
  "properties": {
    "record_kind": {"const": "EXECUTION_RECEIPT"},
    "record_id": {"type": "string", "pattern": "^SYNTHETIC-[A-Z-]+-[0-9]+$"},
    "request_id": {"type": "string", "pattern": "^RTE-SYNTHETIC-[0-9]+$"},
    "synthetic": {"const": true},
    "fixture_only": {"const": true},
    "execution_status": {"const": "NOT_EXECUTED"},
    "tool_invocation": {"const": "NONE"},
    "external_effects_observed": {"const": []},
    "output_material": {"const": null},
    "runtime_execution": {"const": "NOT_IMPLEMENTED"},
    "subject_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_effects_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "persistence": {"const": "ephemeral"}
  }
}
