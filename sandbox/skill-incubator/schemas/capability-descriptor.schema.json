{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lhe:capability-descriptor:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "record_id", "request_id", "synthetic", "fixture_only", "declaration_only", "installation_proven", "callability_proven", "authorization_proven", "execution_proven", "subject_identity_digest", "requested_effects_digest", "source_scope_digest", "input_contract_digest", "persistence"],
  "properties": {
    "record_kind": {"const": "CAPABILITY_DESCRIPTOR"},
    "record_id": {"type": "string", "pattern": "^SYNTHETIC-[A-Z-]+-[0-9]+$"},
    "request_id": {"type": "string", "pattern": "^RTE-SYNTHETIC-[0-9]+$"},
    "synthetic": {"const": true},
    "fixture_only": {"const": true},
    "declaration_only": {"const": true},
    "installation_proven": {"const": false},
    "callability_proven": {"const": false},
    "authorization_proven": {"const": false},
    "execution_proven": {"const": false},
    "subject_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_effects_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "persistence": {"const": "ephemeral"}
  }
}
