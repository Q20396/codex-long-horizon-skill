{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lhe:calculation-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "record_id", "request_id", "synthetic", "fixture_only", "calculation_status", "calculation_replay", "calculation_engine", "calculation_output", "subject_identity_digest", "requested_effects_digest", "source_scope_digest", "input_contract_digest", "persistence"],
  "properties": {
    "record_kind": {"const": "CALCULATION_RECEIPT"},
    "record_id": {"type": "string", "pattern": "^SYNTHETIC-CALCULATION-[0-9]+$"},
    "request_id": {"type": "string", "pattern": "^RTE-SYNTHETIC-[0-9]+$"},
    "synthetic": {"const": true},
    "fixture_only": {"const": true},
    "calculation_status": {"const": "NOT_PERFORMED"},
    "calculation_replay": {"const": "NOT_APPLICABLE"},
    "calculation_engine": {"const": "NONE"},
    "calculation_output": {"const": null},
    "subject_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_effects_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "persistence": {"const": "ephemeral"}
  }
}
