{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lhe:task-grant-record:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "record_id", "request_id", "synthetic", "fixture_only", "grant_status", "granted_effects", "grant_token", "signature", "issued_at", "expires_at", "consumed_at", "subject_identity_digest", "requested_effects_digest", "source_scope_digest", "input_contract_digest", "persistence"],
  "properties": {
    "record_kind": {"const": "TASK_GRANT"},
    "record_id": {"type": "string", "pattern": "^SYNTHETIC-[A-Z-]+-[0-9]+$"},
    "request_id": {"type": "string", "pattern": "^RTE-SYNTHETIC-[0-9]+$"},
    "synthetic": {"const": true},
    "fixture_only": {"const": true},
    "grant_status": {"const": "NOT_ISSUED"},
    "granted_effects": {"const": []},
    "grant_token": {"const": null},
    "signature": {"const": null},
    "issued_at": {"const": null},
    "expires_at": {"const": null},
    "consumed_at": {"const": null},
    "subject_identity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_effects_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "persistence": {"const": "ephemeral"}
  }
}
